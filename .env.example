# ── Required ──
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/vocabmaster"
# Session encryption key. Generate one with:  npx auth secret
AUTH_SECRET=""

# ── Optional ──
# Public URL of the site (used for metadata and sitemap)
NEXT_PUBLIC_SITE_URL="https://vocabmaster.app"

# AI features (word details, text extraction, story mode)
GEMINI_API_KEY=""
# Defaults to gemini-2.5-flash
GEMINI_MODEL=""

# "Continue with Google" — the button only appears when both are set.
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
